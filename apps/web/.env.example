# apps/web/.env — copy to .env and fill from Supabase → Settings → API. Never commit .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile SITE key (public). Dashboard → Turnstile → your widget → Site Key.
# Local dev: 1x00000000000000000000AA always passes (Cloudflare test key).
VITE_TURNSTILE_SITE_KEY=
# Shared secret for the self-hosted image upload service (server/upload).
# Must match the server's UPLOAD_TOKEN. start.sh exports it in dev.
VITE_UPLOAD_TOKEN=
